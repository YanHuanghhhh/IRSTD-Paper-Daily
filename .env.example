# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，不会提交到仓库。
# 格式：每行一个 KEY=VALUE，值不要加行尾注释，也不要留多余空格。

# Server酱 SendKey：SCT 开头为 Turbo，sctp 开头为 Server酱³
SERVERCHAN_SENDKEY=

# 邮件日报：这四项都填齐才会发送
SMTP_HOST=smtp.qq.com
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=

# 以下可选
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# EMAIL_FROM=

# 可选：GitHub Token，用于提高论文代码仓库搜索的 API 限额
# GITHUB_TOKEN=

# 可选：覆盖解释器路径（默认自动使用 conda 环境 daily_arxiv）
# DAILY_ARXIV_PYTHON=/d/MINICONDA/envs/daily_arxiv/python.exe
